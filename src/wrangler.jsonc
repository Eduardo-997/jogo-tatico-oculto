{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jogo-tatico-oculto",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws*"]
  },
  "durable_objects": {
    "bindings": [{"name":"GAME_ROOMS","class_name":"GameRoom"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["GameRoom"]}]
}
